  "scripts": {
    "build": "npm run minify:themes && npm run minify:components",
    "minify": "postcss ./build/css/*.css -d ./build/minified",
    "minify:themes": "postcss build/css/themes/*.css -d ./build/minified",
    "minify:components": "postcss build/css/components/*.css -d ./build/minified",
    "pack": "mkdir -p dist && npm pack && mv *.tgz dist/ && cd dist",
    "pre:release": "auto-changelog -p --prepend && git add CHANGELOG.md"
  },
  "type": "module",
  "repository": {
    "type": "git",
